# Demo account password
DEMO_PASSWORD=
# Public URL used in reset links
APP_URL=
# SMTP host for password reset email
SMTP_HOST=
# SMTP port
SMTP_PORT=
# SMTP username
SMTP_USER=
# SMTP password or app password
SMTP_PASSWORD=
# From address for reset email
MAIL_FROM=
